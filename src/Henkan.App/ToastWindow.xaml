<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Henkan.App.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Henkan.App.Views">

    <!-- Transient acrylic is what Windows uses for its own flyouts, and it is the
         reason this needs no border of its own: the window is the card. -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <views:ToastView x:Name="View" />
</Window>
