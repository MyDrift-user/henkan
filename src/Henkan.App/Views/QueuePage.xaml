<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Henkan.App.Views.QueuePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Henkan.Core.Conversion"
    xmlns:local="using:Henkan.App.Views"
    NavigationCacheMode="Required">

    <Page.Resources>
        <local:StateToGlyphConverter x:Key="StateToGlyph" />
        <local:StateToBrushConverter x:Key="StateToBrush" />
        <local:ProgressVisibilityConverter x:Key="ProgressVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Queue" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <Button Grid.Column="1" Content="Cancel all" VerticalAlignment="Center" Command="{x:Bind ViewModel.CancelAllCommand}" />
            <Button Grid.Column="2" Content="Clear finished" VerticalAlignment="Center" Command="{x:Bind ViewModel.ClearFinishedCommand}" />
        </Grid>

        <!-- Nothing has run yet -->
        <StackPanel
            Grid.Row="1"
            Spacing="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <FontIcon Glyph="&#xE8AB;" FontSize="32" Opacity="0.5" />
            <TextBlock Text="Nothing has been converted yet." HorizontalAlignment="Center" />
            <TextBlock
                Text="Right-click files in Explorer and pick a conversion under Henkan."
                Style="{StaticResource CaptionStyle}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="conv:ConversionJob">
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="{x:Bind State, Mode=OneWay, Converter={StaticResource StateToGlyph}}"
                            Foreground="{x:Bind State, Mode=OneWay, Converter={StaticResource StateToBrush}}"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind InputPath}">
                                <Run Text="{x:Bind InputFileName}" FontWeight="SemiBold" />
                                <Run Text=" to " />
                                <Run Text="{x:Bind Target.Target.Label}" />
                            </TextBlock>
                            <ProgressBar
                                Value="{x:Bind Progress, Mode=OneWay}"
                                Maximum="1"
                                Visibility="{x:Bind State, Mode=OneWay, Converter={StaticResource ProgressVisibility}}" />
                            <TextBlock
                                Text="{x:Bind Message, Mode=OneWay}"
                                Style="{StaticResource CaptionStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind Message, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock
                                Text="{x:Bind OutputPath, Mode=OneWay}"
                                Style="{StaticResource CaptionStyle}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind OutputPath, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Open result"
                                Command="{Binding ElementName=Root, Path=ViewModel.OpenOutputCommand}"
                                CommandParameter="{x:Bind}"
                                Visibility="{x:Bind IsFinished, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </Button>
                            <Button
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Show in folder"
                                Command="{Binding ElementName=Root, Path=ViewModel.OpenOutputFolderCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                            </Button>
                            <Button
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Show log"
                                Click="OnShowLog"
                                Tag="{x:Bind}">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                            </Button>
                            <Button
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Cancel"
                                Command="{Binding ElementName=Root, Path=ViewModel.CancelJobCommand}"
                                CommandParameter="{x:Bind}"
                                Visibility="{x:Bind IsFinished, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
