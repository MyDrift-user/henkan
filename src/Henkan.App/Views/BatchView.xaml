<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Henkan.App.Views.BatchView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Henkan.Core.Conversion"
    xmlns:local="using:Henkan.App.Views">

    <UserControl.Resources>
        <local:StateToGlyphConverter x:Key="StateToGlyph" />
        <local:StateToBrushConverter x:Key="StateToBrush" />
        <local:ProgressVisibilityConverter x:Key="ProgressVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Headline and overall progress -->
        <StackPanel Padding="20,4,20,12" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
            <ProgressBar
                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                Maximum="1"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- One row per file -->
        <ListView
            Grid.Row="1"
            Padding="12,0,12,0"
            ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="conv:ConversionJob">
                    <Grid ColumnSpacing="12" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="{x:Bind State, Mode=OneWay, Converter={StaticResource StateToGlyph}}"
                            Foreground="{x:Bind State, Mode=OneWay, Converter={StaticResource StateToBrush}}"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind InputPath}">
                                <Run Text="{x:Bind InputFileName}" FontWeight="SemiBold" />
                                <Run Text=" to " />
                                <Run Text="{x:Bind Target.Target.Label}" />
                            </TextBlock>
                            <ProgressBar
                                Value="{x:Bind Progress, Mode=OneWay}"
                                Maximum="1"
                                Visibility="{x:Bind State, Mode=OneWay, Converter={StaticResource ProgressVisibility}}" />
                            <TextBlock
                                Text="{x:Bind Message, Mode=OneWay}"
                                Style="{StaticResource CaptionStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind Message, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Show in folder"
                                Command="{Binding ElementName=Root, Path=ViewModel.ShowInFolderCommand}"
                                CommandParameter="{x:Bind}">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                            </Button>
                            <Button
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Show log"
                                Click="OnShowLog"
                                Tag="{x:Bind}">
                                <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Cancel while running, Close once it has stopped -->
        <Grid Grid.Row="2" Padding="20,12,20,20" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Content="Cancel"
                Command="{x:Bind ViewModel.CancelAllCommand}"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <Button
                Grid.Column="1"
                Content="Close"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnClose"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </Grid>
</UserControl>
