<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Henkan.App.Views.ToastView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Henkan.App.Views">

    <UserControl.Resources>
        <local:StateToGlyphConverter x:Key="StateToGlyph" />
        <local:StateToBrushConverter x:Key="StateToBrush" />
        <local:StateToTintConverter x:Key="StateToTint" />
        <local:ProgressVisibilityConverter x:Key="ProgressVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />
        <local:IndeterminateConverter x:Key="Indeterminate" />
    </UserControl.Resources>

    <!-- The window is the card: it carries the acrylic backdrop, the rounded
         corners and the shadow, so there is no second border drawn inside it. -->
    <Grid x:Name="Surface" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="14,13,10,13" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- State, as a tinted disc rather than a bare glyph -->
            <Border
                Width="32" Height="32"
                CornerRadius="16"
                VerticalAlignment="Center"
                Background="{x:Bind Job.State, Mode=OneWay, Converter={StaticResource StateToTint}}">
                <FontIcon
                    Glyph="{x:Bind Job.State, Mode=OneWay, Converter={StaticResource StateToGlyph}}"
                    Foreground="{x:Bind Job.State, Mode=OneWay, Converter={StaticResource StateToBrush}}"
                    FontSize="15" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Job.InputFileName}"
                    FontWeight="SemiBold"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Job.InputPath}" />

                <!-- Either what it is becoming, or what went wrong -->
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Job.Message, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                    <Run Text="to" />
                    <Run Text="{x:Bind Job.Target.Target.Label}" />
                </TextBlock>

                <TextBlock
                    Text="{x:Bind Job.Message, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    MaxLines="3"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind Job.Message, Mode=OneWay, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Show in folder"
                    Click="OnShowInFolder">
                    <FontIcon Glyph="&#xE838;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
                <Button
                    Width="30" Height="30"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Dismiss"
                    Click="OnDismiss">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- A hairline along the bottom edge, the way a notification shows progress -->
        <ProgressBar
            Grid.Row="1"
            Height="3"
            Margin="0"
            Padding="0"
            CornerRadius="0"
            Background="Transparent"
            Value="{x:Bind Job.Progress, Mode=OneWay}"
            Maximum="1"
            IsIndeterminate="{x:Bind Job.Progress, Mode=OneWay, Converter={StaticResource Indeterminate}}"
            Foreground="{x:Bind Job.State, Mode=OneWay, Converter={StaticResource StateToBrush}}"
            Visibility="{x:Bind Job.State, Mode=OneWay, Converter={StaticResource ProgressVisibility}}" />
    </Grid>
</UserControl>
