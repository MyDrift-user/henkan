    {
      "id": "text-png",
      "label": "PNG (via PDF)",
      "outputExtension": "png",
      "category": "Image",
      "description": "Lays the document out first, so the picture matches the printed page.",
      "inputExtensions": [
        "$text"
      ],
      "steps": [
        {
          "targets": [
            "office/word-pdf",
            "libreoffice/pdf"
          ]
        },
        {
          "targets": [
            "ghostscript/png"
          ],
          "options": {
            "Resolution": "{Resolution}",
            "Page": "{Page}"
          }
        }
      ],
      "options": [
        {
          "id": "Resolution",
          "label": "Resolution",
          "kind": "choice",
          "default": "150",
          "unit": "dpi",
          "choices": [
            {
              "value": "72"
            },
            {
              "value": "96"
            },
            {
              "value": "150"
            },
            {
              "value": "300"
            },
            {
              "value": "600"
            }
          ]
        },
        {
          "id": "Page",
          "label": "Page",
          "kind": "integer",
          "default": "1",
          "minimum": 1,
          "maximum": 10000,
          "description": "Which page of the document, once it has been laid out."
        }
      ]
    },
