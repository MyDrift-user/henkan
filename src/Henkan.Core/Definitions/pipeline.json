      "options": [
        {
          "id": "Profile",
          "label": "Profile",
          "kind": "choice",
          "default": "ebook",
          "choices": [
            {
              "value": "screen",
              "label": "Screen (72 dpi, smallest)"
            },
            {
              "value": "ebook",
              "label": "E-book (150 dpi)"
            },
            {
              "value": "printer",
              "label": "Printer (300 dpi)"
            },
