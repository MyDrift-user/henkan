<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Henkan.Core</RootNamespace>
    <AssemblyName>Henkan.Core</AssemblyName>
    <EnableDynamicLoading>false</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Built-in backend definitions ship as embedded JSON. They are the exact
       same shape a user-authored backend file uses, so anything the built-ins
       can express, a custom backend can express too. -->
  <ItemGroup>
    <EmbeddedResource Include="Definitions\*.json" />
  </ItemGroup>

</Project>
